generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id     String  @id @default(uuid())
  phone  String  @unique
  name   String
  role   Role
  avatar String?
  email  String?
  rating Float?
  pushToken String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  driver Driver?
  orders Order[]
}

model Driver {
  id        String  @id @default(uuid())
  userId    String  @unique
  carModel  String?
  carNumber String?
  isOnline  Boolean @default(false)
  rating    Float   @default(5.0)
  lat       Float?
  lng       Float?
  lastSeenAt DateTime?
  pushToken String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id])
  orders Order[]
}

model Order {
  id          String      @id @default(uuid())
  clientId    String
  driverId    String?
  fromAddress String
  toAddress   String?
  status      OrderStatus @default(NEW)
  fromLat     Float
  fromLng     Float
  price       Int?
  toLat       Float?
  toLng       Float?

  completedAt DateTime?
  cancelledAt DateTime?
  cancelledBy CancelledBy?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client User    @relation(fields: [clientId], references: [id])
  driver Driver? @relation(fields: [driverId], references: [id])

  @@index([status])
  @@index([driverId])
  @@index([clientId])
  @@index([createdAt])
}

model TelegramLink {
  id     String @id @default(uuid())
  phone  String @unique
  chatId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([phone])
}

model OtpCode {
  id        String   @id @default(uuid())
  phone     String
  code      String
  attempts  Int      @default(0)
  expiresAt DateTime

  createdAt DateTime @default(now())

  @@index([phone])
}

enum Role {
  CLIENT
  DRIVER
  ADMIN
}

enum OrderStatus {
  NEW
  ACCEPTED
  ARRIVED
  STARTED
  COMPLETED
  CANCELLED
}

enum CancelledBy {
  CLIENT
  DRIVER
}
